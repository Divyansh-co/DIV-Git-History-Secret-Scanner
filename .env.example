# ==============================================================================
# SentraScan — Environment Configuration Template
# ==============================================================================

# Server Configuration
PORT=3001
NODE_ENV=development

# Ephemeral Sandbox Limits
MAX_UPLOAD_SIZE_MB=150
MAX_SCAN_TIMEOUT_MS=90000
MAX_COMMIT_COUNT=1000

# Shannon Entropy Thresholds
DEFAULT_ENTROPY_THRESHOLD=4.2
DEFAULT_MIN_TOKEN_LENGTH=20

# Ephemeral Storage Path
EPHEMERAL_TEMP_DIR=/tmp/sentrascan_uploads
